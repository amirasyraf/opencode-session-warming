{
  "name": "opencode-session-warming",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Provider-aware root-session HTTP cache warming for OpenCode V2 2.1.x and 2.2.x",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "compatibility:matrix": "node scripts/compatibility.ts matrix",
    "test:compatibility": "node scripts/compatibility.ts run",
    "journal": "node journal-cli.ts",
    "test:runtime": "node --test tests/runtime.integration.ts",
    "test:tui": "node --test tests/tui.integration.ts"
  },
  "devDependencies": {
    "@opencode/plugin": "2.1.0",
    "@opencode/theme": "2.1.0",
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@types/node": "26.0.0",
    "solid-js": "1.9.12",
    "typescript": "5.9.3"
  }
}
